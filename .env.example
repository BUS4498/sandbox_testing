# TEMPLATE ONLY — NO REAL CREDENTIALS
# Optional local runtime overrides only.
# Copy to a local .env file only when an override is needed.
# Never commit the populated .env file.
#
# Required for live model and web-search requests. Store the real value only
# in a local ignored .env file or operating-system environment variable.
OPENAI_API_KEY=

# Optional alternative for an ignored local secret file. Do not set both.
# OPENAI_API_KEY_FILE=api_key/openai_api_key.txt

# Required API model ID. Choose an OpenAI API model that supports the
# Responses API, structured output, and web search for discovery runs.
OPENAI_MODEL=gpt-6.1-sol

# Optional supported reasoning level for the selected model. The approved
# initial configuration uses medium reasoning.
OPENAI_REASONING_EFFORT=medium

# The initial API runtime creates verified local previews only. A live email
# provider is intentionally not configured by this template.
EMAIL_NOTIFICATIONS_MODE=DRY_RUN

# The optional owner-only Codex Sites pilot has a separate server-side secret
# configuration and Microsoft Graph authorization flow. Do not paste Site or
# Outlook credentials into this local template; see runtime/codex-sites-private-pilot.md.

# Optional. Leave unset to use the Git-ignored data/local folder in this project.
# INTERNSHIP_AGENT_DATA_DIR=
