# DESIGN-ONLY CONFIGURATION EXAMPLE
# This file is not consumed by a working application in the current phase.
# Copy to .env only after a future implementation exists. Never commit .env.

# Local runtime data directory outside the repository
INTERNSHIP_AGENT_DATA_DIR=

# Student-controlled scheduling; disabled by default
DAILY_RUN_ENABLED=false
DAILY_RUN_LOCAL_TIME=09:00
DAILY_RUN_TIMEZONE=

# Notification destination must be an address controlled and verified by the student
STUDENT_NOTIFICATION_EMAIL=

# Future mail-service configuration. Store secrets only in .env or an OS credential store.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
EMAIL_API_KEY=

